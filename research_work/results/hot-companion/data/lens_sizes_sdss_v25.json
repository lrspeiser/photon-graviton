{
 "experiment": "round 25: the sizes of KiDS-like lenses, from SDSS DR17 (the galaxies whose heat round 12 measured)",
 "sql": "SELECT TOP 120000 s.z, s.velDisp, s.velDispErr, g.lgm_tot_p50, p.modelMag_u, p.modelMag_r, p.fracDeV_r, p.deVRad_r, p.deVAB_r, p.expRad_r, p.expAB_r FROM SpecObj s JOIN galSpecExtra g ON g.specObjID = s.specObjID JOIN PhotoObj p ON p.objID = s.bestObjID WHERE s.class = 'GALAXY' AND s.zWarning = 0 AND s.z BETWEEN 0.1 AND 0.25 AND g.lgm_tot_p50 BETWEEN 9.8 AND 11.3 AND s.velDisp > 0 AND s.velDispErr > 0 AND s.velDispErr < 40",
